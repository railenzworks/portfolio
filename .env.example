# Copy to .env.local for local development; in production set these in
# Vercel > Project > Settings > Environment Variables.

# 2027 calendar pre-orders (app/api/calendar-reservation/route.ts), sent with Resend.
# Create the key at https://resend.com/api-keys — register the Resend account with
# railenzworks@gmail.com so the default sender below is allowed to deliver to it.
RESEND_API_KEY=

# Optional (these are the defaults)
# RESERVATION_TO=railenzworks@gmail.com
# RESERVATION_FROM=Railenz Web <onboarding@resend.dev>

# Public address of the site, used for the share preview of /calendario
# SITE_URL=https://your-domain.com
