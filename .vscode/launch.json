{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Active",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "dev",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Open in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "dev"
    },
    {
      "name": "Open in Edge",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "dev"
    }
  ]
}
